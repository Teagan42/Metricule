{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricule.io/schemas/v1alpha1.schema.json",
  "title": "Metricule Exporter configuration",
  "description": "Declarative configuration for the Metricule metrics sidecar. Structural validation only: cross-field and adapter-capability rules are enforced by `metricule validate`.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "sources", "metrics"],
  "properties": {
    "apiVersion": { "const": "metricule.io/v1alpha1" },
    "kind": { "const": "Exporter" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "server": { "$ref": "#/$defs/server" },
    "defaults": { "$ref": "#/$defs/defaults" },
    "sources": {
      "type": "object",
      "description": "Named data sources. Names are used as telemetry labels.",
      "minProperties": 1,
      "propertyNames": { "$ref": "#/$defs/identifier" },
      "additionalProperties": { "$ref": "#/$defs/source" }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metric" }
    }
  },

  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },

    "duration": {
      "type": "string",
      "description": "Go duration string, such as \"30s\", \"250ms\", or \"5m\".",
      "pattern": "^[0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h)([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))*$"
    },

    "secretRef": {
      "type": "object",
      "description": "Indirect secret reference. Exactly one of value, env, or file.",
      "additionalProperties": false,
      "properties": {
        "value": { "type": "string", "description": "Literal value. Development only." },
        "env": { "type": "string", "description": "Environment variable name." },
        "file": { "type": "string", "description": "Path to a file holding the secret." }
      },
      "oneOf": [
        { "required": ["value"] },
        { "required": ["env"] },
        { "required": ["file"] }
      ]
    },

    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      }
    },

    "server": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "listen": { "type": "string" },
        "metrics_path": { "$ref": "#/$defs/httpPath" },
        "health_path": { "$ref": "#/$defs/httpPath" },
        "readiness_path": { "$ref": "#/$defs/httpPath" }
      }
    },

    "httpPath": {
      "type": "string",
      "pattern": "^/"
    },

    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "collection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interval": { "$ref": "#/$defs/duration" },
            "timeout": { "$ref": "#/$defs/duration" },
            "reconcile_interval": { "$ref": "#/$defs/duration" },
            "debounce": { "$ref": "#/$defs/duration" },
            "jitter": { "$ref": "#/$defs/duration" }
          }
        },
        "limits": { "$ref": "#/$defs/limits" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },

    "limits": {
      "type": "object",
      "description": "Resource bounds. Every value must be positive.",
      "additionalProperties": false,
      "properties": {
        "max_series_per_metric": { "type": "integer", "minimum": 1 },
        "max_rows_per_query": { "type": "integer", "minimum": 1 },
        "max_concurrent_collections": { "type": "integer", "minimum": 1 },
        "max_total_series": { "type": "integer", "minimum": 1 },
        "max_metrics": { "type": "integer", "minimum": 1 },
        "max_label_value_bytes": { "type": "integer", "minimum": 1 }
      }
    },

    "failure": {
      "type": "object",
      "description": "Staleness policy. Neither mode substitutes zero for an unavailable value.",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["retain", "drop"],
          "description": "retain exposes the last successful snapshot until max_stale_age; drop omits samples immediately."
        },
        "max_stale_age": { "$ref": "#/$defs/duration" }
      }
    },

    "source": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        { "$ref": "#/$defs/postgresSource" },
        { "$ref": "#/$defs/sqliteSource" },
        { "$ref": "#/$defs/httpSource" },
        { "$ref": "#/$defs/mysqlSource" }
      ]
    },

    "postgresSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dsn"],
      "properties": {
        "type": { "const": "postgres" },
        "dsn": { "$ref": "#/$defs/secretRef" },
        "query_timeout": { "$ref": "#/$defs/duration" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_open": { "type": "integer", "minimum": 1 },
            "max_idle": { "type": "integer", "minimum": 0 }
          }
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"] },
            "root_cert": { "type": "string" },
            "cert": { "type": "string" },
            "key": { "type": "string" }
          }
        },
        "triggers": {
          "type": "object",
          "description": "Opt-in managed notification triggers. Disabled unless manage is true.",
          "additionalProperties": false,
          "required": ["manage"],
          "properties": {
            "manage": { "type": "boolean" },
            "schema": { "$ref": "#/$defs/identifier" },
            "cleanup_on_shutdown": { "type": "boolean" },
            "dsn": { "$ref": "#/$defs/secretRef" }
          }
        }
      }
    },

    "sqliteSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "sqlite" },
        "path": { "type": "string", "minLength": 1 },
        "readonly": {
          "const": true,
          "description": "SQLite access is read-only in v0.1 (AD-007)."
        },
        "busy_timeout": { "$ref": "#/$defs/duration" },
        "change_check_interval": { "$ref": "#/$defs/duration" }
      }
    },

    "httpSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "base_url"],
      "properties": {
        "type": { "const": "http" },
        "base_url": { "type": "string", "pattern": "^https?://" },
        "timeout": { "$ref": "#/$defs/duration" },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "authentication": { "$ref": "#/$defs/authentication" },
        "allowed_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpPath" }
        },
        "max_response_bytes": { "type": "integer", "minimum": 1 },
        "max_redirects": { "type": "integer", "minimum": 0 },
        "retries": { "type": "integer", "minimum": 0 }
      }
    },

    "mysqlSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "dsn"],
      "properties": {
        "type": { "const": "mysql" },
        "dsn": { "$ref": "#/$defs/secretRef" },
        "query_timeout": { "$ref": "#/$defs/duration" },
        "pool": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_open": { "type": "integer", "minimum": 1 },
            "max_idle": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },

    "authentication": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "token"],
          "properties": {
            "type": { "const": "bearer" },
            "token": { "$ref": "#/$defs/secretRef" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "username", "password"],
          "properties": {
            "type": { "const": "basic" },
            "username": { "type": "string", "minLength": 1 },
            "password": { "$ref": "#/$defs/secretRef" }
          }
        }
      ]
    },

    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "help", "type", "source", "mapping"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z_:][a-zA-Z0-9_:]*$",
          "not": {
            "anyOf": [
              { "pattern": "^metricule_" },
              { "pattern": "_bucket$" },
              { "pattern": "_sum$" }
            ]
          },
          "description": "Prometheus metric name. The metricule_ prefix is reserved for exporter telemetry; _bucket and _sum are reserved for histogram and summary families."
        },
        "help": { "type": "string", "minLength": 1 },
        "type": {
          "enum": ["gauge", "counter", "state_set"],
          "description": "state_set emits one gauge series per configured state."
        },
        "source": { "$ref": "#/$defs/identifier" },
        "query": {
          "type": "object",
          "description": "Database sources only.",
          "additionalProperties": false,
          "required": ["sql"],
          "properties": {
            "sql": { "type": "string", "minLength": 1 }
          }
        },
        "request": {
          "type": "object",
          "description": "HTTP sources only.",
          "additionalProperties": false,
          "required": ["path"],
          "properties": {
            "method": { "const": "GET" },
            "path": { "$ref": "#/$defs/httpPath" },
            "params": { "type": "object", "additionalProperties": { "type": "string" } },
            "headers": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        },
        "mapping": { "$ref": "#/$defs/mapping" },
        "collect": { "$ref": "#/$defs/collect" },
        "limits": { "$ref": "#/$defs/limits" },
        "failure": { "$ref": "#/$defs/failure" }
      }
    },

    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": {
        "rows": {
          "type": "string",
          "description": "RFC 9535 JSONPath selecting repeating elements. HTTP sources only."
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "description": "Column name for SQL sources, RFC 9535 JSONPath for HTTP sources."
        },
        "labels": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/labelName" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "static_labels": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/labelName" },
          "additionalProperties": { "type": "string" }
        },
        "states": {
          "type": "array",
          "description": "Allowed values for a state_set metric. Bounds state cardinality by configuration.",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "scale": { "type": "number" },
        "null": {
          "enum": ["fail", "omit"],
          "description": "Null handling. Defaults to fail; null is never coerced to zero."
        }
      }
    },

    "labelName": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$",
      "not": { "pattern": "^__" }
    },

    "collect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["poll", "notify", "auto"],
          "description": "manual and cdc are reserved for a future release and are rejected in v0.1."
        },
        "interval": { "$ref": "#/$defs/duration" },
        "timeout": { "$ref": "#/$defs/duration" },
        "channel": { "type": "string", "minLength": 1 },
        "fallback_interval": {
          "$ref": "#/$defs/duration",
          "description": "Mandatory reconciliation for notify and auto modes: notification delivery is not durable."
        },
        "debounce": { "$ref": "#/$defs/duration" },
        "jitter": { "$ref": "#/$defs/duration" },
        "require_notifications": {
          "type": "boolean",
          "description": "Fail startup instead of degrading when the source cannot deliver notifications. notify and auto only."
        },
        "watch": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "tables": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "events": {
              "type": "array",
              "items": { "enum": ["insert", "update", "delete"] }
            }
          }
        }
      }
    }
  }
}
